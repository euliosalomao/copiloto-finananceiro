      "id": "0bdcd99e-7cde-43ba-b0d1-09dafe0b84b5",
      "name": "getReport1"
    },
    {
      "parameters": {
        "jsCode": "const {\n  period,\n  accountId,\n  report\n} = $input.first().json;\n\nconst {\n  summary,\n  expensesByCategory = [],\n  topExpenses = []\n} = report;\n\nconst {\n  income,\n  expenses,\n  balance,\n  transactionCount\n} = summary;\n\nfunction dinheiro(valor) {\n  return new Intl.NumberFormat(\"pt-BR\", {\n    style: \"currency\",\n    currency: \"BRL\"\n  }).format(valor);\n}\n\nfunction categoria(nome) {\n  if (!nome || nome === \"SEM_CATEGORIA\") {\n    return \"Sem categoria\";\n  }\n\n  return nome;\n}\n\nfunction dataBr(data) {\n  if (!data) return \"\";\n\n  const [ano, mes, dia] = data.split(\"-\");\n  return `${dia}/${mes}/${ano}`;\n}\n\nfunction descricao(texto) {\n  return texto\n    ?.replace(/\\s+/g, \" \")\n    .trim();\n}\n\n\n// -------------------------\n// CATEGORIAS\n// -------------------------\n\nconst categorias = expensesByCategory.map(item => {\n  return `${categoria(item.category)}: ${dinheiro(item.amount)}`;\n});\n\n\n// -------------------------\n// MAIORES GASTOS\n// -------------------------\n\nconst maioresGastos = topExpenses.map((item, index) => {\n  return [\n    `${index + 1}. ${descricao(item.description)}`,\n    `${dinheiro(item.amount)} — ${categoria(item.category)}`,\n    `${dataBr(item.date)}`\n  ].join(\"\\n\");\n});\n\n\n// -------------------------\n// MENSAGEM FINAL\n// -------------------------\n\nconst mensagem = [\n  `Relatório mensal — ${String(period.month).padStart(2, \"0\")}/${period.year}`,\n\n  ``,\n\n  `Resumo`,\n  `Entradas: ${dinheiro(income)}`,\n  `Saídas: ${dinheiro(expenses)}`,\n  `Saldo: ${dinheiro(balance)}`,\n  `Transações: ${transactionCount}`,\n\n  ``,\n\n  `Gastos por categoria`,\n  categorias.length\n    ? categorias.join(\"\\n\")\n    : \"Nenhum gasto por categoria.\",\n\n  ``,\n\n  `Maiores gastos`,\n  topExpenses.length\n    ? maioresGastos.join(\"\\n\\n\")\n    : \"Nenhum gasto encontrado.\"\n].join(\"\\n\");\n\n\nreturn [\n  {\n    json: {\n      period,\n      accountId,\n\n      resumo: {\n        entradas: income,\n        saidas: expenses,\n        saldo: balance,\n        transacoes: transactionCount\n      },\n\n      categorias: expensesByCategory.map(item => ({\n        categoria: categoria(item.category),\n        valor: item.amount\n      })),\n\n      maioresGastos: topExpenses.map(item => ({\n        descricao: descricao(item.description),\n        valor: item.amount,\n        data: dataBr(item.date),\n        categoria: categoria(item.category)\n      })),\n\n      mensagem\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        -16
