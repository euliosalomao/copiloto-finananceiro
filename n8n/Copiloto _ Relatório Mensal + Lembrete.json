        "url": "=http://copiloto_backend:3333/report?month={{ $now.minus({ months: 1 }).month }}&year={{ $now.minus({ months: 1 }).year }}&accountId={acountId}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
